    <script>
        function lerNumero(valorInput) {
            if (!valorInput) return 0;
            if (typeof valorInput === 'number') return valorInput;
            let texto = valorInput.toString().trim();
            texto = texto.replace(/[^\d.,-]/g, ''); 
            if (texto.includes(',')) {
                texto = texto.replace(/\./g, '').replace(',', '.');
            }
            let numero = parseFloat(texto);
            return isNaN(numero) ? 0 : numero;
        }

        function formatarMoeda(numero) {
            if (!numero || isNaN(numero)) numero = 0;
            return numero.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function escaparHTML(valor) {
            return String(valor ?? '')
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        }

        const FORMAS_PAGAMENTO = [
            "Nubank (Crédito)", "Sicredi (Crédito)", 
            "Cartão Débito", "Dinheiro", "PIX", "Boleto"
        ];

        const CATEGORIAS = [
            "🏠 Moradia", "🍔 Alimentação", "🚗 Transporte", 
            "🏥 Saúde", "📚 Educação", "🎉 Lazer", 
            "🛒 Compras", "💼 Negócios", "💸 Outros"
        ];

        const CORES_CATEGORIAS = {
            "🏠 Moradia": "bg-blue-400", "🍔 Alimentação": "bg-orange-400", "🚗 Transporte": "bg-slate-400",
            "🏥 Saúde": "bg-emerald-400", "📚 Educação": "bg-indigo-400", "🎉 Lazer": "bg-purple-400",
            "🛒 Compras": "bg-pink-400", "💼 Negócios": "bg-cyan-400", "💸 Outros": "bg-slate-500"
        };

        const DADOS_VAZIOS = { limites: { nubank: 0, sicredi: 0, chequeEspecial: 0 }, config: { fechaNu: 25, fechaSicredi: 25 }, meses: {} };
        
        function clonarDadosVazios() {
            return JSON.parse(JSON.stringify(DADOS_VAZIOS));
        }

        function normalizarDatabase(dados) {
            const base = dados && typeof dados === 'object' ? dados : clonarDadosVazios();
            if (!base.limites) base.limites = {};
            if (!base.config) base.config = {};
            if (!base.meses) base.meses = {};
            base.limites.nubank = lerNumero(base.limites.nubank);
            base.limites.sicredi = lerNumero(base.limites.sicredi);
            base.limites.chequeEspecial = lerNumero(base.limites.chequeEspecial);
            base.config.fechaNu = Math.min(31, Math.max(1, parseInt(base.config.fechaNu) || 25));
            base.config.fechaSicredi = Math.min(31, Math.max(1, parseInt(base.config.fechaSicredi) || 25));
            Object.values(base.meses).forEach(mes => {
                if (!Array.isArray(mes.rendas)) mes.rendas = [];
                if (!Array.isArray(mes.despesas)) mes.despesas = [];
                mes.rendas.forEach(r => r.valor = lerNumero(r.valor));
                mes.despesas.forEach(d => d.valor = lerNumero(d.valor));
            });
            return base;
        }

        function temGoogleAppsScript() {
            return typeof google !== 'undefined' && google.script && google.script.run;
        }

        let database = clonarDadosVazios();
        let anoVisaoMeses = new Date().getFullYear();

        window.onload = function() {
            lucide.createIcons();
            
            const cacheAntigo = localStorage.getItem('Controle_Master_v23');
            const carregarCache = () => {
                try { database = normalizarDatabase(cacheAntigo ? JSON.parse(cacheAntigo) : null); }
                catch (erro) { database = clonarDadosVazios(); }
                renderizarGeral();
            };

            if (!temGoogleAppsScript()) {
                carregarCache();
                mudarStatusSelo("Salvo neste aparelho", "bg-indigo-500/10 border-indigo-500/20", "text-indigo-400", "hard-drive");
                return;
            }

            google.script.run
                .withSuccessHandler(function(dadosNuvem) {
                    try {
                        database = normalizarDatabase(dadosNuvem ? JSON.parse(dadosNuvem) : (cacheAntigo ? JSON.parse(cacheAntigo) : null));
                    } catch (erro) {
                        database = normalizarDatabase(cacheAntigo ? JSON.parse(cacheAntigo) : null);
                    }
                    renderizarGeral();
                    mudarStatusSelo("Sincronizado", "bg-emerald-500/10 border-emerald-500/20", "text-emerald-400", "check-circle-2");
                    if (!dadosNuvem && cacheAntigo) salvarDB();
                })
                .withFailureHandler(function() {
                    carregarCache();
                    mudarStatusSelo("Modo local", "bg-orange-500/10 border-orange-500/20", "text-orange-400", "wifi-off");
                    mostrarToast("Sem conexão com a nuvem. Os dados continuam salvos neste aparelho.");
                })
                .carregarDadosNuvem();
        };

        function mostrarToast(msg) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = "bg-slate-800 border border-slate-700 text-white px-3 py-2 rounded-lg shadow-2xl font-medium text-[10px] flex items-center gap-2 transform transition-all duration-300 translate-y-10 opacity-0";
            toast.innerHTML = `<i data-lucide="info" class="w-3.5 h-3.5 text-indigo-400"></i> ${msg}`;
            container.appendChild(toast);
            lucide.createIcons();

            requestAnimationFrame(() => toast.classList.remove('translate-y-10', 'opacity-0'));

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function mudarStatusSelo(texto, corBg, corTexto, icone) {
            const selo = document.getElementById('status-salvamento');
            selo.className = `text-[9px] ${corBg} ${corTexto} px-2 py-0.5 rounded-full font-bold uppercase tracking-widest inline-flex items-center gap-1 border`;
            let iconHtml = icone === 'loader-2' ? `<i data-lucide="${icone}" class="w-2.5 h-2.5 spin"></i>` : `<i data-lucide="${icone}" class="w-2.5 h-2.5"></i>`;
            selo.innerHTML = `${iconHtml} ${texto}`;
            lucide.createIcons();
        }

        function salvarDB() {
            localStorage.setItem('Controle_Master_v23', JSON.stringify(database));
            if (!temGoogleAppsScript()) {
                mudarStatusSelo("Salvo neste aparelho", "bg-indigo-500/10 border-indigo-500/20", "text-indigo-400", "hard-drive");
                return;
            }
            mudarStatusSelo("A Salvar...", "bg-slate-800 border-slate-700", "text-slate-400", "loader-2");

            google.script.run
                .withSuccessHandler(function() {
                    mudarStatusSelo("Sincronizado", "bg-emerald-500/10 border-emerald-500/20", "text-emerald-400", "check-circle-2");
                })
                .withFailureHandler(function() {
                    mudarStatusSelo("Salvo localmente", "bg-orange-500/10 border-orange-500/20", "text-orange-400", "wifi-off");
                })
                .salvarDadosNuvem(JSON.stringify(database));
        }

        let dataAtual = new Date(); 

        function getChaveMes(data) {
            return `${data.getFullYear()}-${String(data.getMonth() + 1).padStart(2, '0')}`;
        }

        function getDataAtualDB() {
            const chave = getChaveMes(dataAtual);
            if (!database.meses[chave]) database.meses[chave] = { rendas: [], despesas: [] };
            return database.meses[chave];
        }

        function mudarMes(direcao) {
            dataAtual.setDate(1);
            dataAtual.setMonth(dataAtual.getMonth() + direcao);
            renderizarGeral();
        }

        function alternarAba(aba) {
            const btnLancamentos = document.getElementById('btn-aba-lancamentos');
            const btnDashboard = document.getElementById('btn-aba-dashboard');
            const btnMeses = document.getElementById('btn-aba-meses');
            const abaLancamentos = document.getElementById('aba-lancamentos');
            const abaDashboard = document.getElementById('aba-dashboard');
            const abaMeses = document.getElementById('aba-meses');

            [abaLancamentos, abaDashboard, abaMeses].forEach(el => el.classList.add('hidden'));
            [btnLancamentos, btnDashboard, btnMeses].forEach(btn => {
                btn.className = "pb-2 border-b-2 border-transparent font-semibold text-slate-500 hover:text-slate-300 text-xs flex items-center gap-1.5 transition-all";
            });

            if(aba === 'lancamentos') {
                abaLancamentos.classList.remove('hidden');
                btnLancamentos.className = "pb-2 border-b-2 border-indigo-500 font-bold text-indigo-400 text-xs flex items-center gap-1.5 transition-all";
            } else if (aba === 'dashboard') {
                abaDashboard.classList.remove('hidden');
                btnDashboard.className = "pb-2 border-b-2 border-indigo-500 font-bold text-indigo-400 text-xs flex items-center gap-1.5 transition-all";
                renderizarDashboardAnalitico();
            } else {
                abaMeses.classList.remove('hidden');
                btnMeses.className = "pb-2 border-b-2 border-indigo-500 font-bold text-indigo-400 text-xs flex items-center gap-1.5 transition-all";
                anoVisaoMeses = dataAtual.getFullYear();
                renderizarMeses();
            }
        }

        function obterChaveFatura(dataStr, tipoPagamento) {
            if (!dataStr) return null;
            let parts = dataStr.split('-');
            let y = parseInt(parts[0]);
            let m = parseInt(parts[1]);
            let d = parseInt(parts[2]);

            let fechaDia = 32; 
            if (tipoPagamento === 'Nubank (Crédito)') fechaDia = database.config.fechaNu;
            if (tipoPagamento === 'Sicredi (Crédito)') fechaDia = database.config.fechaSicredi;

            if (d >= fechaDia) {
                m = m + 1;
                if (m > 12) {
                    m = 1;
                    y = y + 1;
                }
            }
            return `${y}-${String(m).padStart(2, '0')}`;
        }

        function adicionarMesSeguro(dataBase, quantidade) {
            const ano = dataBase.getFullYear();
            const mes = dataBase.getMonth() + quantidade;
            const diaOriginal = dataBase.getDate();
            const ultimoDia = new Date(ano, mes + 1, 0).getDate();
            return new Date(ano, mes, Math.min(diaOriginal, ultimoDia), 12, 0, 0);
        }

        function atualizarDashboards() {
            let totalRendas = 0, receitasPagas = 0;
            let totalDespesasGeral = 0, despesasGeralPagas = 0, despesasContaPagas = 0;
            let saldoAnterior = 0;
            let faturaNu = 0, faturaSicredi = 0;

            const chaveAtual = getChaveMes(dataAtual);

            Object.keys(database.meses).forEach(chaveLoop => {
                let mesLoop = database.meses[chaveLoop];
                let isMesAnterior = chaveLoop < chaveAtual;
                let isMesAtual = chaveLoop === chaveAtual;

                mesLoop.rendas.forEach(r => {
                    if (isMesAtual) {
                        totalRendas += r.valor;
                        if (r.status) receitasPagas += r.valor;
                    }
                    if (isMesAnterior && r.status) saldoAnterior += r.valor;
                });

                mesLoop.despesas.forEach(d => {
                    let isNu = d.tipo === 'Nubank (Crédito)';
                    let isSicredi = d.tipo === 'Sicredi (Crédito)';
                    
                    if (isNu && !d.status) faturaNu += d.valor;
                    if (isSicredi && !d.status) faturaSicredi += d.valor;

                    if (isMesAtual) {
                        totalDespesasGeral += d.valor;
                        if (d.status) {
                            despesasContaPagas += d.valor; 
                            despesasGeralPagas += d.valor; 
                        }
                    }

                    if (isMesAnterior && d.status) {
                        saldoAnterior -= d.valor;
                    }
                });
            });

            faturaNu = Math.max(0, faturaNu);
            faturaSicredi = Math.max(0, faturaSicredi);

            document.getElementById('card-renda-total').innerText = `R$ ${formatarMoeda(totalRendas)}`;
            document.getElementById('card-renda-paga').innerText = `R$ ${formatarMoeda(receitasPagas)}`;
            
            document.getElementById('card-desp-total').innerText = `R$ ${formatarMoeda(totalDespesasGeral)}`;
            document.getElementById('card-desp-paga').innerText = `R$ ${formatarMoeda(despesasGeralPagas)}`;
            
            // CÁLCULO SALDO + CHEQUE ESPECIAL
            const saldoAcumulado = saldoAnterior + receitasPagas - despesasContaPagas;
            const limiteCheque = database.limites.chequeEspecial || 0;

            document.getElementById('card-saldo-anterior').innerText = `R$ ${formatarMoeda(saldoAnterior)}`;
            
            const elSaldoAtual = document.getElementById('card-saldo-atual');
            elSaldoAtual.innerText = `R$ ${formatarMoeda(saldoAcumulado)}`;
            
            if (saldoAcumulado < 0) {
                elSaldoAtual.className = "text-2xl font-black font-mono tracking-tighter transition-colors duration-300 text-red-400 drop-shadow-md";
            } else {
                elSaldoAtual.className = "text-2xl font-black font-mono tracking-tighter transition-colors duration-300 text-white drop-shadow-md";
            }

            document.getElementById('limite-cheque').value = limiteCheque ? formatarMoeda(limiteCheque) : '';
            
            const containerCheque = document.getElementById('container-cheque-uso');
            
            if (saldoAcumulado >= 0) {
                containerCheque.innerHTML = `
                    <div class="bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/20 flex items-center gap-1 shadow-sm">
                        <i data-lucide="shield-check" class="w-3 h-3"></i>
                        <span class="text-[8px] uppercase tracking-widest font-bold">Livre</span>
                    </div>
                `;
            } else {
                let chequeUsado = Math.abs(saldoAcumulado);
                let chequeDisponivel = limiteCheque - chequeUsado;
                
                if (chequeDisponivel < 0) {
                    containerCheque.innerHTML = `
                        <div class="bg-red-500/10 px-2 py-0.5 rounded border border-red-500/20 text-right">
                            <span class="text-[8px] text-red-400 uppercase tracking-widest font-bold block">Estourado</span>
                            <span class="text-[9px] font-mono font-black text-white">- R$ ${formatarMoeda(Math.abs(chequeDisponivel))}</span>
                        </div>
                    `;
                } else {
                    containerCheque.innerHTML = `
                        <div class="bg-orange-500/10 px-2 py-0.5 rounded border border-orange-500/20 text-right animate-pulse">
                            <span class="text-[8px] text-orange-400 uppercase tracking-widest font-bold block">Uso: R$ ${formatarMoeda(chequeUsado)}</span>
                            <span class="text-[9px] font-mono font-black text-white">Livre: R$ ${formatarMoeda(chequeDisponivel)}</span>
                        </div>
                    `;
                }
            }

            // CARTÕES
            const dispNu = database.limites.nubank - faturaNu;
            const dispSicredi = database.limites.sicredi - faturaSicredi;

            document.getElementById('fatura-nubank').innerText = `R$ ${formatarMoeda(faturaNu)}`;
            document.getElementById('disponivel-nubank').innerText = `R$ ${formatarMoeda(dispNu)}`;
            document.getElementById('fatura-sicredi').innerText = `R$ ${formatarMoeda(faturaSicredi)}`;
            document.getElementById('disponivel-sicredi').innerText = `R$ ${formatarMoeda(dispSicredi)}`;

            const percNu = database.limites.nubank > 0 ? Math.min((faturaNu / database.limites.nubank) * 100, 100) : 0;
            const percSicredi = database.limites.sicredi > 0 ? Math.min((faturaSicredi / database.limites.sicredi) * 100, 100) : 0;
            document.getElementById('progresso-nubank').style.width = `${percNu}%`;
            document.getElementById('progresso-nubank').className = `h-full progress-bar-fill shadow-[0_0_8px_rgba(168,85,247,0.8)] ${percNu >= 100 ? 'bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.8)]' : 'bg-purple-500'}`;
            document.getElementById('progresso-sicredi').style.width = `${percSicredi}%`;
            document.getElementById('progresso-sicredi').className = `h-full progress-bar-fill shadow-[0_0_8px_rgba(16,185,129,0.8)] ${percSicredi >= 100 ? 'bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.8)]' : 'bg-emerald-500'}`;
        }

        function renderizarDashboardAnalitico() {
            const dadosMes = getDataAtualDB();
            let totalDespesasReais = 0;
            let totalRendas = 0;
            let gastosPorTipo = {};

            dadosMes.rendas.forEach(r => totalRendas += r.valor);

            dadosMes.despesas.forEach(d => {
                if (d.valor > 0) { 
                    totalDespesasReais += d.valor;
                    let catSegura = d.categoria || "💸 Outros";
                    if(!gastosPorTipo[catSegura]) gastosPorTipo[catSegura] = 0;
                    gastosPorTipo[catSegura] += d.valor;
                }
            });

            document.getElementById('dash-tot-renda').innerText = `R$ ${formatarMoeda(totalRendas)}`;
            document.getElementById('dash-tot-despesa').innerText = `R$ ${formatarMoeda(totalDespesasReais)}`;
            
            let percentualGasto = totalRendas > 0 ? Math.min((totalDespesasReais / totalRendas) * 100, 100) : 0;
            document.getElementById('dash-perc-gasto').innerText = `${percentualGasto.toFixed(0)}%`;
            document.getElementById('dash-barra-gasto').style.width = `${percentualGasto}%`;
            
            if(percentualGasto > 85) document.getElementById('dash-barra-gasto').className = "bg-red-500 h-full progress-bar-fill shadow-md";
            else if(percentualGasto > 60) document.getElementById('dash-barra-gasto').className = "bg-orange-500 h-full progress-bar-fill shadow-md";
            else document.getElementById('dash-barra-gasto').className = "bg-indigo-500 h-full progress-bar-fill shadow-[0_0_8px_rgba(99,102,241,0.6)]";

            const containerGrafico = document.getElementById('grafico-categorias');
            containerGrafico.innerHTML = '';

            let arrayGastos = Object.keys(gastosPorTipo).map(cat => {
                return { categoria: cat, valor: gastosPorTipo[cat] };
            });
            arrayGastos.sort((a, b) => b.valor - a.valor);

            if (arrayGastos.length === 0) {
                containerGrafico.innerHTML = `<p class="text-xs text-slate-500 text-center py-6">Sem despesas.</p>`;
                return;
            }

            arrayGastos.forEach(item => {
                let perc = (item.valor / totalDespesasReais) * 100;
                let corClasse = CORES_CATEGORIAS[item.categoria] || 'bg-slate-600';

                containerGrafico.innerHTML += `
                    <div class="mb-3">
                        <div class="flex justify-between items-end mb-1">
                            <span class="text-[10px] font-bold text-slate-300 uppercase tracking-wider">${escaparHTML(item.categoria)}</span>
                            <span class="text-xs font-mono font-bold text-white">R$ ${formatarMoeda(item.valor)} <span class="text-[9px] text-slate-500 ml-1">(${perc.toFixed(0)}%)</span></span>
                        </div>
                        <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                            <div class="${corClasse} h-full progress-bar-fill shadow-sm" style="width: ${perc}%"></div>
                        </div>
                    </div>
                `;
            });
        }

        function renderizarMeses() {
            const grade = document.getElementById('grade-meses');
