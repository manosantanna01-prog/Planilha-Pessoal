                            <div>
                                <p class="text-[9px] uppercase tracking-widest text-slate-500 font-bold">${anoVisaoMeses}</p>
                                <h3 class="text-sm text-white font-black capitalize">${nomeMes}</h3>
                            </div>
                            ${mesAtual ? '<span class="text-[8px] bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 px-2 py-0.5 rounded-full font-bold uppercase">Selecionado</span>' : ''}
                        </div>
                        <div class="grid grid-cols-2 gap-2 mb-3">
                            <div class="bg-emerald-500/5 border border-emerald-500/10 rounded-lg p-2">
                                <span class="text-[8px] uppercase text-slate-500 font-bold block">Receitas</span>
                                <strong class="text-[11px] text-emerald-400 font-mono">R$ ${formatarMoeda(receitas)}</strong>
                            </div>
                            <div class="bg-red-500/5 border border-red-500/10 rounded-lg p-2">
                                <span class="text-[8px] uppercase text-slate-500 font-bold block">Despesas</span>
                                <strong class="text-[11px] text-red-400 font-mono">R$ ${formatarMoeda(despesas)}</strong>
