        window.salvarTexto = function(tipo, id, campo, valor) {
            const chaveAtual = getChaveMes(dataAtual);
            const dadosMes = database.meses[chaveAtual];
            let lista = tipo === 'renda' ? dadosMes.rendas : dadosMes.despesas;
            let item = lista.find(x => x.id === id);
            
            if(item) {
                item[campo] = valor;

                if (tipo === 'despesa' && (campo === 'vencimento' || campo === 'tipo') && item.vencimento) {
                    let novaChave = obterChaveFatura(item.vencimento, item.tipo);
                    if (novaChave && novaChave !== chaveAtual) {
                        database.meses[chaveAtual].despesas = database.meses[chaveAtual].despesas.filter(x => x.id !== id);
                        if (!database.meses[novaChave]) database.meses[novaChave] = { rendas: [], despesas: [] };
                        
                        let novoId = 1;
                        if (database.meses[novaChave].despesas.length > 0) {
                            novoId = Math.max(...database.meses[novaChave].despesas.map(d => d.id)) + 1;
                        }
                        item.id = novoId;
                        database.meses[novaChave].despesas.unshift(item); 

                        let mesFormatado = novaChave.split('-').reverse().join('/');
                        mostrarToast(`Movido para a fatura de ${mesFormatado}`);
                    }
                }

                salvarDB();
                renderizarGeral();
            }
        }

        window.salvarValor = function(tipo, id, campo, inputEl) {
            let numeroLido = lerNumero(inputEl.value);
            inputEl.value = numeroLido > 0 ? formatarMoeda(numeroLido) : ''; 
            
            const dadosMes = getDataAtualDB();
            let lista = tipo === 'renda' ? dadosMes.rendas : dadosMes.despesas;
            let item = lista.find(x => x.id === id);
            if(item) {
                item[campo] = numeroLido;
                salvarDB();
                atualizarDashboards(); 
            }
        }

        window.salvarLimiteEConfig = function(tipo, inputEl) {
            let numeroLido = lerNumero(inputEl.value);
            if(tipo === 'nubank' || tipo === 'sicredi') {
                inputEl.value = numeroLido > 0 ? formatarMoeda(numeroLido) : '';
                database.limites[tipo] = numeroLido;
            } else if (tipo === 'cheque') {
                inputEl.value = numeroLido > 0 ? formatarMoeda(numeroLido) : '';
                database.limites.chequeEspecial = numeroLido;
            } else if (tipo === 'nubank-fecha') {
                database.config.fechaNu = Math.min(31, Math.max(1, Math.trunc(numeroLido) || 25));
            } else if (tipo === 'sicredi-fecha') {
                database.config.fechaSicredi = Math.min(31, Math.max(1, Math.trunc(numeroLido) || 25));
            }
            salvarDB();
            atualizarDashboards();
        }

        window.adicionarLinha = function(tipo) {
            const dadosMes = getDataAtualDB();
            if (tipo === 'renda') {
                const newId = dadosMes.rendas.length ? Math.max(...dadosMes.rendas.map(r => r.id)) + 1 : 1;
                dadosMes.rendas.unshift({ id: newId, nome: "", valor: 0, status: false });
            } else {
                const newId = dadosMes.despesas.length ? Math.max(...dadosMes.despesas.map(d => d.id)) + 1 : 1;
                dadosMes.despesas.unshift({ id: newId, nome: "", categoria: "💸 Outros", tipo: "", vencimento: "", valor: 0, status: false });
            }
            salvarDB(); 
            renderizarGeral();
        };

        window.removerLinha = function(tipo, id) {
            if(confirm("Remover este item?")) {
                const dadosMes = getDataAtualDB();
                if (tipo === 'renda') dadosMes.rendas = dadosMes.rendas.filter(r => r.id !== id);
                else dadosMes.despesas = dadosMes.despesas.filter(d => d.id !== id);
                salvarDB(); 
                renderizarGeral();
            }
        };

        window.toggleStatus = function(tipo, id) {
            const dadosMes = getDataAtualDB();
            let lista = tipo === 'renda' ? dadosMes.rendas : dadosMes.despesas;
            let item = lista.find(x => x.id === id);
            if(item) {
                item.status = !item.status;
                salvarDB();
                renderizarGeral();
                if (tipo === 'despesa' && (item.tipo === 'Nubank (Crédito)' || item.tipo === 'Sicredi (Crédito)')) {
                    mostrarToast(item.status ? 'Pagamento antecipado: limite devolvido ao cartão.' : 'Antecipação desfeita: valor debitado novamente do cartão.');
                }
            }
        };

        window.abrirModalParcelamento = function() {
            document.getElementById('modal-parcelamento').classList.remove('hidden');
            document.getElementById('modal-parcelamento').classList.add('flex');
            document.getElementById('parc-data').value = new Date().toISOString().split('T')[0];
        }

        window.fecharModalParcelamento = function() {
            document.getElementById('modal-parcelamento').classList.add('hidden');
            document.getElementById('modal-parcelamento').classList.remove('flex');
            document.getElementById('parc-desc').value = '';
            document.getElementById('parc-valor').value = '';
            document.getElementById('parc-qtd').value = '';
            document.getElementById('parc-categoria').value = '💸 Outros';
        }

        window.salvarParcelamento = function() {
            let desc = document.getElementById('parc-desc').value;
            let cat = document.getElementById('parc-categoria').value;
            let valorText = document.getElementById('parc-valor').value;
            let qtdText = document.getElementById('parc-qtd').value;
            let cartao = document.getElementById('parc-cartao').value;
            let dataStr = document.getElementById('parc-data').value;

            let valor = lerNumero(valorText);
            let qtd = parseInt(qtdText);

            if(!desc || valor <= 0 || !qtd || !cartao || !dataStr) {
                alert("Por favor, preencha todos os campos.");
                return;
            }

            let dataBase = new Date(dataStr + 'T12:00:00'); 

            for(let i = 0; i < qtd; i++) {
                let dataParcela = adicionarMesSeguro(dataBase, i);
                
                let strDataParcela = dataParcela.toISOString().split('T')[0];
                let chaveMes = obterChaveFatura(strDataParcela, cartao);
                
                if(!database.meses[chaveMes]) {
                    database.meses[chaveMes] = { rendas: [], despesas: [] };
                }
                
                let idMax = 0;
                database.meses[chaveMes].despesas.forEach(d => { if(d.id > idMax) idMax = d.id; });
                
                database.meses[chaveMes].despesas.unshift({
                    id: idMax + 1,
                    nome: `${desc} (${i+1}/${qtd})`,
                    categoria: cat,
                    tipo: cartao,
                    vencimento: strDataParcela,
                    valor: valor,
                    status: false
                });
            }

            salvarDB();
            fecharModalParcelamento();
            renderizarGeral();
            mostrarToast(`Lançados ${qtd} meses com sucesso!`);
        }

        window.compartilharApp = function() {
            const linkApp = document.referrer || window.location.href;
            if (navigator.share) {
                navigator.share({
                    title: 'Planilha Pessoal',
                    url: linkApp
                }).catch(console.error);
            } else {
                navigator.clipboard.writeText(linkApp).then(() => {
                    mostrarToast("Link copiado para a área de transferência!");
                }).catch(() => {
                    prompt("Copie o link abaixo:", linkApp);
                });
            }
        }

        window.exportarParaExcel = function() {
            const dadosMes = getDataAtualDB();
            const nomeMes = document.getElementById('mes-display').innerText.replace(' ', '_');
            let csv = "\uFEFFNatureza;Descrição;Categoria;Forma de Pagamento;Vencimento;Valor;Status\n";
            const campoCSV = valor => `"${String(valor ?? '').replace(/"/g, '""')}"`;
            
            dadosMes.rendas.forEach(r => {
                let status = r.status ? "Recebido" : "Pendente";
                let valor = r.valor.toFixed(2).replace('.', ',');
                csv += `Receita;${campoCSV(r.nome)};-;-;-;R$ ${valor};${status}\n`;
            });
            dadosMes.despesas.forEach(d => {
                let status = '';
                let isCartao = d.tipo === 'Nubank (Crédito)' || d.tipo === 'Sicredi (Crédito)';
                if(isCartao) {
                    status = d.status ? 'Antecipado' : 'Na Fatura';
                } else {
                    status = d.status ? "Pago" : "Pendente";
                }
                let valor = d.valor.toFixed(2).replace('.', ',');
                let cat = d.categoria || '💸 Outros';
                csv += `Despesa;${campoCSV(d.nome)};${campoCSV(cat)};${campoCSV(d.tipo)};${campoCSV(d.vencimento)};R$ ${valor};${status}\n`;
            });
            
            const link = document.createElement("a");
            link.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
            link.download = `Relatorio_Mensal_${nomeMes}.csv`;
            document.body.appendChild(link); link.click(); document.body.removeChild(link);
            setTimeout(() => URL.revokeObjectURL(link.href), 1000);
        };

    </script>
</body>
