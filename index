        window.fecharModalDespesaMes = function() {
            const modal = document.getElementById('modal-despesa-mes');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            ['despesa-mes-desc', 'despesa-mes-valor'].forEach(id => document.getElementById(id).value = '');
        };

        window.salvarDespesaMes = function() {
            const chaveEscolhida = document.getElementById('despesa-mes-chave').value;
            const desc = document.getElementById('despesa-mes-desc').value.trim();
            const categoria = document.getElementById('despesa-mes-categoria').value;
            const tipo = document.getElementById('despesa-mes-tipo').value;
            const vencimento = document.getElementById('despesa-mes-data').value;
            const valor = lerNumero(document.getElementById('despesa-mes-valor').value);

            if (!desc || !categoria || !tipo || !vencimento || valor <= 0) {
                alert('Preencha a descrição, a categoria, a forma de pagamento, a data e um valor válido.');
                return;
            }

            const chaveDestino = obterChaveFatura(vencimento, tipo) || chaveEscolhida;
            if (!database.meses[chaveDestino]) database.meses[chaveDestino] = { rendas: [], despesas: [] };
            const lista = database.meses[chaveDestino].despesas;
            const novoId = lista.length ? Math.max(...lista.map(item => Number(item.id) || 0)) + 1 : 1;
            lista.unshift({ id: novoId, nome: desc, categoria, tipo, vencimento, valor, status: false });

            salvarDB();
            fecharModalDespesaMes();
            renderizarGeral();
            renderizarMeses();
            const ehCartao = tipo === 'Nubank (Crédito)' || tipo === 'Sicredi (Crédito)';
            if (ehCartao) mostrarToast(`Despesa lançada e debitada do limite do ${tipo.split(' ')[0]}.`);
            else mostrarToast('Despesa adicionada com sucesso.');
        };

