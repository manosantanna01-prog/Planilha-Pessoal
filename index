                const chave = `${anoVisaoMeses}-${String(indiceMes + 1).padStart(2, '0')}`;
                const dados = database.meses[chave] || { rendas: [], despesas: [] };
                const receitas = dados.rendas.reduce((total, item) => total + lerNumero(item.valor), 0);
                const despesas = dados.despesas.reduce((total, item) => total + lerNumero(item.valor), 0);
                const saldo = receitas - despesas;
                const nomeMes = new Intl.DateTimeFormat('pt-BR', { month: 'long' })
                    .format(new Date(anoVisaoMeses, indiceMes, 1));
                const mesAtual = chave === getChaveMes(dataAtual);

                grade.innerHTML += `
                    <div class="glass-panel rounded-xl p-4 border ${mesAtual ? 'border-indigo-500/50' : 'border-white/5'} compact-hover">
