        window.mudarAnoMeses = function(direcao) {
            anoVisaoMeses += direcao;
            renderizarMeses();
        };

        window.abrirMes = function(ano, mesIndex) {
            dataAtual = new Date(ano, mesIndex, 1);
            renderizarGeral();
            alternarAba('lancamentos');
        };

        window.abrirModalDespesaMes = function(chave) {
            const [ano, mes] = chave.split('-').map(Number);
            const modal = document.getElementById('modal-despesa-mes');
            const seletorCategoria = document.getElementById('despesa-mes-categoria');
            const seletorTipo = document.getElementById('despesa-mes-tipo');
            seletorCategoria.innerHTML = CATEGORIAS.map(cat => `<option value="${cat}" ${cat === '💸 Outros' ? 'selected' : ''}>${cat}</option>`).join('');
            seletorTipo.innerHTML = '<option value="">Selecione...</option>' + FORMAS_PAGAMENTO.map(tipo => `<option value="${tipo}">${tipo}</option>`).join('');
            document.getElementById('despesa-mes-chave').value = chave;
            document.getElementById('despesa-mes-data').value = `${chave}-01`;
            document.getElementById('despesa-mes-referencia').innerText = new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric' }).format(new Date(ano, mes - 1, 1));
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            lucide.createIcons();
            setTimeout(() => document.getElementById('despesa-mes-desc').focus(), 50);
